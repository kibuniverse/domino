{
  "name": "@kibuniverse/domino",
  "type": "module",
  "version": "0.1.2",
  "description": "Select React elements in your browser and edit their source with a local coding agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibuniverse/domino.git"
  },
  "bugs": "https://github.com/kibuniverse/domino/issues",
  "homepage": "https://github.com/kibuniverse/domino#readme",
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "codex",
    "claude",
    "agent",
    "coding-agent",
    "dx",
    "webpack",
    "rspack"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.6.3",
  "volta": {
    "node": "22.23.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "webpack": "^5.0.0",
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@openai/codex-sdk": "0.160.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./transform": {
      "types": "./dist/transform.d.mts",
      "import": "./dist/transform.mjs"
    },
    "./agents/codex": {
      "types": "./dist/codex.d.mts",
      "import": "./dist/codex.mjs"
    },
    "./agents/claude": {
      "types": "./dist/claude.d.mts",
      "import": "./dist/claude.mjs"
    },
    "./package.json": "./package.json",
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.mts",
        "default": "./dist/rspack.mjs"
      },
      "require": {
        "types": "./dist/rspack.d.cts",
        "default": "./dist/rspack.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "example": "pnpm build && vite examples/react --host 127.0.0.1",
    "example:claude": "pnpm build && DOMINO_AGENT=claude vite examples/react --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:pub && pnpm test:package",
    "typecheck": "tsc --noEmit",
    "lint:pub": "publint && attw --pack . --profile esm-only",
    "release": "bumpp",
    "prepublishOnly": "pnpm run check",
    "example:webpack": "pnpm build && webpack serve --config examples/webpack/webpack.config.mjs",
    "example:rspack": "pnpm build && rspack dev --config examples/rspack/rspack.config.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7",
    "@babel/preset-react": "^7",
    "@babel/preset-typescript": "^7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.63.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@rspack/cli": "^2",
    "@rspack/core": "^2",
    "@rspack/dev-server": "^2",
    "@rspack/plugin-react-refresh": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-loader": "^10",
    "bumpp": "^11.1.0",
    "css-loader": "^7.1.5",
    "publint": "^0.3.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-refresh": "^0.19.0",
    "rspack-dev-server-v1": "npm:@rspack/dev-server@^1",
    "rspack-refresh-v1": "npm:@rspack/plugin-react-refresh@^1",
    "rspack-v1": "npm:@rspack/core@^1",
    "style-loader": "^4.0.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "webpack": "^5",
    "webpack-cli": "^6",
    "webpack-dev-server": "^5"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "diff": "^8.0.0",
    "magic-string": "^0.30.0",
    "motion": "^14.0.0",
    "ws": "^8.18.0"
  }
}
